# 应用配置
# 应用在接口文档等位置显示的名称
APP_NAME=My Agent RAG API
# 应用版本号
APP_VERSION=0.1.0
# 所有 API 路由的统一前缀
API_PREFIX=/api/v1
# 服务监听地址；127.0.0.1 表示仅本机可以访问
HOST=127.0.0.1
# 服务监听端口
PORT=8000
# 开发模式是否自动重载代码
RELOAD=true
# 数据目录，数据库、上传文件和解析结果都会保存在此目录下
DATA_DIR=data

# MinerU 本地解析配置
# MinerU 可执行命令或完整路径；留空时自动从 PATH 和当前虚拟环境中查找
MINERU_EXECUTABLE=
# PDF 文件使用的 MinerU 解析档位
MINERU_TIER_PDF=basic
# 非 PDF 文件使用的 MinerU 解析档位，例如 DOCX
MINERU_TIER_NON_PDF=flash
# 单次 MinerU 解析的最长等待时间，单位为秒
MINERU_TIMEOUT_SECONDS=3600

# 文档切分配置；长度按字符数计算
# 每个文本块的目标字符数
CHUNK_SIZE=800
# 相邻文本块之间重复保留的字符数，用于减少边界处的上下文丢失
CHUNK_OVERLAP=100
# Worker 查询待处理任务的间隔，单位为秒
WORKER_POLL_INTERVAL_SECONDS=2

# 大语言模型配置；接入模型服务后填写
# 模型服务的 API 密钥
OPENAI_API_KEY=your_api_key_here
# 对话模型名称
CHAT_MODEL=your_chat_model_here
# 文本向量化模型名称
EMBEDDING_MODEL=your_embedding_model_here
# Embedding 服务的 OpenAI 兼容 API 基础地址，通常以 /v1 结尾
EMBEDDING_BASE_URL=
# Embedding 服务密钥
EMBEDDING_API_KEY=
# 模型实际返回的向量维度，用于创建 Milvus 集合
EMBEDDING_DIMENSION=

# 数据库服务。DATABASE_URL 留空时使用本地 SQLite。
DATABASE_URL=
# 配置后启动时检查 Milvus REST API。留空时不连接 Milvus。
MILVUS_URI=
MILVUS_TOKEN=
